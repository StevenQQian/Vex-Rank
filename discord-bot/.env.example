# From https://discord.com/developers/applications → your app → Bot → Reset Token
DISCORD_TOKEN=
# From https://www.robotevents.com/api/v2 → Request Access / API Tokens
ROBOT_EVENTS_API_TOKEN=
# Only needed if the bot is in more than one server.
DISCORD_GUILD_ID=
# Defaults to "verify".
VERIFY_CHANNEL=verify
# Cloudflare dashboard → My Profile → API Tokens → Create Token → "Edit Cloudflare Workers"
CLOUDFLARE_API_TOKEN=
# Role given on verification. Leave empty to only rename.
VERIFIED_ROLE=User
